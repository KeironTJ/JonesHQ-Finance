# FamilyHQ Finance Environment Configuration
# Copy this file to .env and update with your actual values
# NEVER commit the .env file to version control!

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development

# SECURITY WARNING: Only set FLASK_DEBUG=1 when actively debugging
# Debug mode exposes sensitive information (debugger PIN, stack traces, etc.)
# NEVER enable debug mode on a public/production server
FLASK_DEBUG=0

# Secret Key - MUST be changed in production!
# Generate a secure key with: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
# For SQLite (default):
DATABASE_URL=sqlite:///instance/joneshq_finance.db

# For PostgreSQL (production):
# DATABASE_URL=postgresql://username:password@localhost/joneshq_finance

# For MySQL (production):
# DATABASE_URL=mysql://username:password@localhost/joneshq_finance

# Outgoing email (password reset links, email confirmation, security alerts)
# Leave MAIL_SERVER empty to turn email off. Example for Resend (resend.com):
# MAIL_SERVER=smtp.resend.com
# MAIL_PORT=465
# MAIL_USE_SSL=true
# MAIL_USE_TLS=false
# MAIL_USERNAME=resend
# MAIL_PASSWORD=re_your_api_key
# MAIL_FROM=Family HQ <noreply@yourdomain.co.uk>
# Public address of the site, used to build links in emails (must be https:// in production)
# APP_BASE_URL=https://finance.yourdomain.co.uk

# CRITICAL SECURITY REMINDERS:
# ❌ NEVER enable FLASK_DEBUG=1 on a public server (exposes debugger PIN)
# ❌ NEVER share your SECRET_KEY
# ❌ NEVER commit .env file to Git (it's in .gitignore)
# ❌ NEVER use default SECRET_KEY in production
# ✅ Always use HTTPS in production
# ✅ Generate random SECRET_KEY for production
# ✅ Keep database credentials secure
